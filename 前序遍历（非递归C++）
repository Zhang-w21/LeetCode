class Solution {
public:
    vector<int> preorderTraversal(TreeNode* root) {
        if(!root)return{};
        vector<int>res;
        stack<TreeNode*>st;
        TreeNode*p=root;
        while(p||!st.empty()){
            while(p){
                res.push_back(p->val);
                st.push(p);
                p=p->left;
            }
            if(!st.empty()){
                p=st.top();
                st.pop();
                p=p->right;
            }
        }
        return res;
    }
};
